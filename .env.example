# Token bot lấy từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=

# API key HOCAI (danglamgiau.com) — lấy trong dashboard sau khi đăng nhập
# Có thể dùng HOCAI_API_KEY thay cho OPENAI_API_KEY
OPENAI_API_KEY=

# Gateway HOCAI, tương thích OpenAI SDK (không gọi api.openai.com)
OPENAI_BASE_URL=https://danglamgiau.com/v1

# Model chat (mặc định theo docs HOCAI)
OPENAI_MODEL=gpt-4o

# Model tạo ảnh cho lệnh /img (docs: Tạo ảnh với GPT)
OPENAI_IMAGE_MODEL=gpt-image-2

# Số lượt hội thoại gần nhất giữ trong bộ nhớ (mỗi lượt = user + assistant)
HISTORY_LIMIT=10

# Telegram user ID được phép chat với bot, phân cách bằng dấu phẩy.
# Gửi /getid cho bot để lấy ID, rồi điền vào đây rồi restart container.
# Ví dụ: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=
